# Example local secrets file.
# Copy this file to k8s/secrets.local.yaml, replace all REPLACE_* placeholders,
# and apply with `kubectl apply -f k8s/secrets.local.yaml`.
# Do not commit the filled-in file.
---
apiVersion: v1
kind: Secret
metadata:
  name: auth-db-secrets
  namespace: nacfson-auth
type: Opaque
stringData:
  POSTGRES_DB: "auth_db"
  POSTGRES_USER: "auth_user"
  POSTGRES_PASSWORD: "REPLACE_WITH_ROTATED_PASSWORD"
  DATABASE_URL: "postgres://auth_user:REPLACE_WITH_ROTATED_PASSWORD@auth-db.nacfson-auth.svc.cluster.local:5432/auth_db?sslmode=require"
---
apiVersion: v1
kind: Secret
metadata:
  name: auth-bootstrap
  namespace: nacfson-auth
type: Opaque
stringData:
  BOOTSTRAP_ADMIN_EMAIL: "admin@nacfson.cloud"
  BOOTSTRAP_ADMIN_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD"
  AUTH_INTERNAL_TOKEN: "REPLACE_WITH_STRONG_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: auth-admin-users
  namespace: nacfson-auth
type: Opaque
stringData:
  admins.yaml: |
    admins:
      - email: admin@nacfson.cloud
        password: REPLACE_WITH_STRONG_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: manager-auth-secrets
  namespace: nacfson-personal
type: Opaque
stringData:
  AUTH_INTERNAL_TOKEN: "REPLACE_WITH_STRONG_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: shared-app-db-secrets
  namespace: nacfson-data
type: Opaque
stringData:
  POSTGRES_DB: "postgres"
  POSTGRES_USER: "admin"
  POSTGRES_PASSWORD: "REPLACE_WITH_ROTATED_PASSWORD"
  DATABASE_URL: "postgres://admin:REPLACE_WITH_ROTATED_PASSWORD@shared-app-db.nacfson-data.svc.cluster.local:5432/postgres?sslmode=require"
---
apiVersion: v1
kind: Secret
metadata:
  name: project-pn-secrets
  namespace: project-pn
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_WITH_ROTATED_PASSWORD"
  DATABASE_URL: "postgres://project_pn:REPLACE_WITH_ROTATED_PASSWORD@postgres:5432/project_pn?sslmode=require"
  ENRICH_BASE_URL: "http://enricher:8787"
  ENRICH_API_KEY: "REPLACE_WITH_ROTATED_API_KEY"
  ENRICH_MODEL: "english-dictionary-fallback-v1"
  EMAIL_PROVIDER: "log"
  EMAIL_FROM: "auth@example.com"
  APP_PUBLIC_URL: "https://pn.nacfson.cloud"
  ALLOWED_ORIGINS: "https://pn.nacfson.cloud,http://localhost:8081,tauri://localhost,http://tauri.localhost"
  AUTH_MODE: "central"
  CENTRAL_AUTH_URL: "https://auth.nacfson.cloud"
  CENTRAL_AUTH_INTERNAL_URL: "http://auth-service.nacfson-auth.svc.cluster.local:8080"
