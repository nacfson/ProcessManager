# Remote Compose / Bitwarden Secrets Manager template.
# Copy to .env and fill in, OR create Bitwarden secrets with the SAME names.
#
#   cp .env.example .env && chmod 600 .env
#   # or: bws run --project-id "$BWS_PROJECT_ID" -- docker compose up -d
#
# Generate secrets:
#   openssl rand -base64 32

# --- Image / ports ---
PROCESSMANAGER_IMAGE=processmanager:latest
AUTH_HOST_PORT=8080
MANAGER_HOST_PORT=8081

# --- Postgres (compose service hostname is "postgres") ---
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=REPLACE_WITH_ROTATED_PASSWORD

# Auth service DSN. Use sslmode=disable for the bundled compose Postgres.
# If the password has special characters, URL-encode them.
DATABASE_URL=postgres://auth_user:REPLACE_WITH_ROTATED_PASSWORD@postgres:5432/auth_db?sslmode=disable

# --- Auth service ---
COOKIE_DOMAIN=example.com
SESSION_TTL=168h
AUTH_INTERNAL_TOKEN=REPLACE_WITH_STRONG_TOKEN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Comma-separated. Include every consumer origin (web app, local dev, deep links).
AUTH_API_ALLOWED_ORIGINS=https://app.example.com
AUTH_ALLOWED_REDIRECTS=https://app.example.com/,http://localhost:8081

# --- Optional manager profile (`docker compose --profile manager up -d`) ---
DOMAIN=example.com
AUTH_HOST=auth.example.com
AUTH_SERVICE_URL=http://auth:8080
USE_FAKE_K8S=true
SHARED_DATABASE_URL=
