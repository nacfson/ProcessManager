# Bitwarden Secure Note → .env example
# ------------------------------------
# 1. In Bitwarden (Password Manager), create a Secure Note named e.g.
#    "processmanager-remote-env".
# 2. Paste EVERYTHING below the "BEGIN" line into the note body
#    (or paste only the KEY=value lines — both work).
# 3. On the remote server, export the note to .env (see deploy/README.md).
#
# Generate secrets with: openssl rand -base64 32
# URL-encode special characters in POSTGRES_PASSWORD inside DATABASE_URL.

# ===== BEGIN SECURE NOTE BODY =====
PROCESSMANAGER_IMAGE=ghcr.io/nacfson/processmanager:latest
AUTH_HOST_PORT=8080

POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=8vK2mQ9xR4nL7pW1sT6yU0zA3bC5dE=

DATABASE_URL=postgres://auth_user:8vK2mQ9xR4nL7pW1sT6yU0zA3bC5dE=@postgres:5432/auth_db?sslmode=disable

COOKIE_DOMAIN=example.com
SESSION_TTL=168h
AUTH_INTERNAL_TOKEN=G7hJ2kL9mN4pQ6rS1tV8wX0yZ3aB5cD=

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=P3qR6sT9uV2wX5yZ8aB1cD4eF7gH0j=

AUTH_API_ALLOWED_ORIGINS=https://app.example.com
AUTH_ALLOWED_REDIRECTS=https://app.example.com/,http://localhost:8081
# ===== END SECURE NOTE BODY =====
